+            try t.expectEqual(original.request_id, preparing.intent.request_id);
+            try t.expect(preparing.plan_id >= previous_plan);
+            previous_plan = preparing.plan_id;
+            // No execution/group is allocated by the headroom wait itself.
+            try t.expect(preparing.cold_candidate == null);
+        }
+        if (ready_count == 3) saw_three = true;
+        // One genuine decode per turn exposes the missing-final-stem boundary.
+        _ = try rig.engine.workerOne();
+        const pcm = try rig.engine.run.render(256);
+        a.free(pcm);
+    }
+    try t.expect(saw_wait and saw_three and published);
+    var accepted: usize = 0;
+    while (try owner.pollReceiptV1()) |receipt| {
+        try t.expectEqualDeep(original, receipt.ticket);
+        if (receipt.event == .accepted) accepted += 1;
+        if (receipt.event == .terminal) try t.expect(receipt.event.terminal == .executed);
+    }
+    try t.expectEqual(@as(usize, 1), accepted);
+}
diff --git a/tests/sme/live_initial_headroom_test.zig b/tests/sme/live_initial_headroom_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..021f0d2e7b206782582cc8fcd5ffb8d2f676be41
--- /dev/null
+++ b/tests/sme/live_initial_headroom_test.zig
@@ -0,0 +1,295 @@
+//! Initial headroom comes only from actual Render receipts acquired by Control.
+//! These single-owner tests decode the existing Opus source. Actual-flow cases
+//! fabricate no PCM, descriptor, admission, or acknowledged prefix. Separately
+//! labeled invariant negatives corrupt only detached copies of real receipts.
+const std = @import("std");
+const t = std.testing;
+const streaming = @import("sme-streaming");
+const stream = streaming.stream;
+const opus = @import("sme-opus");
+const indexer = @import("sme-stream-index");
+const fixtures = @import("sme-opus-fixtures");
+
+fn profile() streaming.StreamCapacityProfile {
+    // Preserve the production ring/chunk/watermark values, including 6144 high.
+    // Only the fixture's stream, job, ledger, and encoded-byte bounds are small.
+    return .{ .max_streams = 2, .job_capacity = 2, .completion_capacity = 2, .visibility_capacity = 2, .max_encoded_chunk_bytes = 65536 };
+}
+
+const Memory = struct {
+    bytes: []const u8 = fixtures.cases[0].encoded,
+    reads: usize = 0,
+
+    fn read(raw: *anyopaque, offset: u64, destination: []u8) opus.Error!void {
+        const self: *Memory = @ptrCast(@alignCast(raw));
+        self.reads += 1;
+        if (offset > self.bytes.len or destination.len > self.bytes.len - offset) return error.TruncatedContainer;
+        @memcpy(destination, self.bytes[@intCast(offset)..][0..destination.len]);
+    }
+};
+
+const Fixture = struct {
+    memory: Memory = .{},
+    index: indexer.Index = undefined,
+    service: *streaming.Service = undefined,
+    asset: streaming.Asset = undefined,
+
+    fn initInPlace(self: *Fixture) !void {
+        self.index = try indexer.build(t.allocator, self.memory.bytes, .{ .interval_frames = 4800, .target_chunk_bytes = 1024, .max_chunk_bytes = 65536 });
+        errdefer self.index.deinit();
+        self.service = try streaming.Service.create(t.allocator, profile());
+        errdefer self.service.destroy() catch unreachable;
+        self.service.clock = null;
+        self.asset = try self.service.prepareAsset(.{
+            .sound_index = 0,
+            .sound = .{ .key = .{ .id = 11 }, .storage = .streaming, .layout = self.index.info.layout, .channels = self.index.info.channels, .channel_mask = self.index.info.channel_mask, .frames = self.index.info.audible_frames, .blob_length = self.memory.bytes.len, .audio_hash = self.index.encoded_hash, .chunks = .{ .count = @intCast(self.index.chunks.len) }, .seeks = .{ .count = @intCast(self.index.seeks.len) } },
+            .codec = self.index.info.codec(@splat(1)),
+            .chunks = self.index.chunks,
+            .seeks = self.index.seeks,
+            .source = .{ .context = &self.memory, .length = self.memory.bytes.len, .read_at = Memory.read },
+        });
+        errdefer self.asset.retire();
+        try self.service.attachRuntime();
+    }
+
+    fn deinit(self: *Fixture) void {
+        self.service.detachRuntimeQuiescent() catch unreachable;
+        self.asset.retire();
+        std.debug.assert(self.asset.canDestroy());
+        self.service.destroy() catch unreachable;
+        self.index.deinit();
+    }
+
+    fn open(self: *Fixture, layer: u64, cursor: u64) !stream.Handle {
+        return self.service.open(&self.asset, .{ .generation = 1, .transport_epoch = 1, .group = 21, .layer = layer, .start_cursor = cursor });
+    }
+
+    fn accept(self: *Fixture, handle: stream.Handle, serial: u64) !stream.Accepted {
+        const prefix = try self.service.acknowledgedVisiblePrefix(handle);
+        const job = (try self.service.request(handle)).?;
+        try t.expectEqual(prefix, try self.service.acknowledgedVisiblePrefix(handle));
+        try t.expectEqual(job, (try self.service.workerOne()).?);
+        // The real verified source may legitimately remain in the byte cache.
+        try t.expect(self.memory.reads > 0);
+        try t.expectEqual(prefix, try self.service.acknowledgedVisiblePrefix(handle));
+        var attempt: stream.LiveAcceptanceAttemptV1 = undefined;
+        const accepted = (try self.service.acceptCompletedLiveV1(.{ .accepted_control_frame = 0, .control_tick = serial, .input_order = 0 }, serial, &attempt)).?;
+        try t.expectEqual(job, accepted.input.payload.worker.job);
+        try t.expectEqual(.ready, accepted.input.payload.worker.state);
+        try t.expectEqual(@as(u64, 0), attempt.cut.?.frame);
+        try t.expectEqual(prefix, try self.service.acknowledgedVisiblePrefix(handle));
+        return accepted;
+    }
+};
+
+test "initial 6144 headroom requires each actual admitted receipt to be polled by Control" {
+    var fixture: Fixture = .{};
+    try fixture.initInPlace();
+    defer fixture.deinit();
+    const service = fixture.service;
+    const handle = try fixture.open(31, 0);
+    defer service.close(handle) catch unreachable;
+    const untouched = try fixture.open(32, 0);
+    defer service.close(untouched) catch unreachable;
+    const pcm = try service.ringFor(handle);
+    try t.expectEqual(@as(u32, 6144), service.profile.high_frames);
+    try t.expectEqual(@as(u64, 0), try service.acknowledgedVisiblePrefix(handle));
+    try t.expectEqual(@as(u64, 0), try service.acknowledgedVisiblePrefix(untouched));
+    var empty: stream.observation.Visibility = .{};
+    try t.expect(service.pollVisibilityObserved(&empty) == null);
+    try t.expect(!empty.acknowledged);
+
+    var prefix: u64 = 0;
+    var serial: u64 = 1;
+    while (prefix < service.profile.high_frames) : (serial += 1) {
+        const accepted = try fixture.accept(handle, serial);
+        const produced = pcm.produced.load(.acquire);
+        try t.expectEqual(prefix + service.profile.decode_chunk_frames, produced);
+        try t.expectEqual(prefix, pcm.visible_produced.load(.acquire));
+        // Accepted worker bytes and the publication frontier are not receipts.
+        try t.expect(service.pollVisibilityObserved(&empty) == null);
+        try t.expect(!empty.acknowledged);
+        try t.expectEqual(prefix, try service.acknowledgedVisiblePrefix(handle));
+
+        service.beginRenderGate(serial, 0);
+        const admission = (try service.admitPublication(service.publicationFrontier(), serial, 0, 0)).?;
+        try t.expectEqual(.admitted, admission.disposition);
+        service.endRenderSpan(0);
+        try t.expectEqual(produced, pcm.visible_produced.load(.acquire));
+        // Even genuine Render visibility grants no Control credit before poll.
+        try t.expectEqual(prefix, try service.acknowledgedVisiblePrefix(handle));
+        if (produced == service.profile.high_frames) {
+            try t.expect(prefix < service.profile.high_frames);
+            try t.expectEqual(@as(u64, 6144), produced);
+        }
+
+        var receipt: stream.observation.Visibility = .{};
+        try t.expectEqualDeep(admission, service.pollVisibilityObserved(&receipt).?);
+        try t.expect(receipt.acknowledged);
+        const descriptor = receipt.descriptor.?;
+        try t.expectEqual(handle.index, descriptor.stream_slot);
+        try t.expectEqual(handle.generation, descriptor.stream_generation);
+        try t.expectEqual(accepted.input.payload.worker.job, descriptor.worker_job);
+        try t.expectEqual(prefix, descriptor.prefix_start);
+        try t.expectEqual(produced, descriptor.prefix_end);
+        prefix = descriptor.prefix_end;
+        try t.expectEqual(prefix, try service.acknowledgedVisiblePrefix(handle));
+        try t.expectEqual(@as(u64, 0), try service.acknowledgedVisiblePrefix(untouched));
+        try t.expect(service.pollVisibilityObserved(&empty) == null);
+        try t.expect(!empty.acknowledged);
+        try t.expectEqual(prefix, try service.acknowledgedVisiblePrefix(handle));
+    }
+    try t.expectEqual(@as(u64, 6144), prefix);
+    try t.expect((try service.request(handle)) == null);
+}
+
+fn stoppedReceipts(initially_admitted: bool) !void {
+    var fixture: Fixture = .{};
+    try fixture.initInPlace();
+    defer fixture.deinit();
+    const service = fixture.service;
+    const handle = try fixture.open(31, 0);
+    defer service.close(handle) catch unreachable;
+    const pcm = try service.ringFor(handle);
+    var serial: u64 = 1;
+    var prefix: u64 = 0;
+    if (initially_admitted) {
+        _ = try fixture.accept(handle, serial);
+        service.beginRenderGate(serial, 0);
+        const admitted = (try service.admitPublication(service.publicationFrontier(), serial, 0, 0)).?;
+        try t.expectEqual(.admitted, admitted.disposition);
+        service.endRenderSpan(0);
+        try t.expectEqualDeep(admitted, service.pollVisibility().?);
+        prefix = try service.acknowledgedVisiblePrefix(handle);
+        try t.expectEqual(@as(u64, service.profile.decode_chunk_frames), prefix);
+        serial += 1;
+    }
+    _ = try fixture.accept(handle, serial);
+    _ = try fixture.accept(handle, serial + 1);
+    // Isolated stopped-input negative, not normal stop-lifecycle qualification.
+    // The ensuing dispositions and receipt descriptors come exclusively from
+    // admitPublication and pollVisibilityObserved, not injected output.
+    pcm.stopped.store(true, .release);
+    service.beginRenderGate(serial, 0);
+    const frontier = service.publicationFrontier();
+    for (0..2) |ordinal| {
+        const admission = (try service.admitPublication(frontier, serial, 0, @intCast(ordinal))).?;
+        try t.expectEqual(.rejected, admission.disposition);
+        try t.expectEqual(prefix, try service.acknowledgedVisiblePrefix(handle));
+        var receipt: stream.observation.Visibility = .{};
+        try t.expectEqualDeep(admission, service.pollVisibilityObserved(&receipt).?);
+        try t.expect(receipt.acknowledged);
+        try t.expectEqual(prefix + ordinal * service.profile.decode_chunk_frames, receipt.descriptor.?.prefix_start);
+        try t.expectEqual(prefix + (ordinal + 1) * service.profile.decode_chunk_frames, receipt.descriptor.?.prefix_end);
+        try t.expectEqual(prefix, try service.acknowledgedVisiblePrefix(handle));
+    }
+    service.endRenderSpan(0);
+    try t.expectEqual(prefix + 2 * service.profile.decode_chunk_frames, pcm.visible_produced.load(.acquire));
+    try t.expect(service.pollVisibility() == null);
+    try t.expectEqual(prefix, try service.acknowledgedVisiblePrefix(handle));
+    var sample: [1]f32 = undefined;
+    try t.expect(!pcm.peek(0, 0, &sample));
+}
+
+test "stopped rejected receipts give no initial prefix credit" {
+    try stoppedReceipts(false);
+}
+
+test "stopped rejected receipts preserve but never extend an admitted prefix" {
+    try stoppedReceipts(true);
+}
+
+test "close and reopen reject stale handles and reset receipt credit for a reused slot" {
+    var fixture: Fixture = .{};
+    try fixture.initInPlace();
+    defer fixture.deinit();
+    const service = fixture.service;
+    var current: ?stream.Handle = try fixture.open(31, 0);
+    defer if (current) |handle| service.close(handle) catch unreachable;
+    const old = current.?;
+    _ = try fixture.accept(old, 1);
+    service.beginRenderGate(1, 0);
+    const first = (try service.admitPublication(service.publicationFrontier(), 1, 0, 0)).?;
+    service.endRenderSpan(0);
+    try t.expectError(error.DrainPending, service.close(old));
+    try t.expectEqual(@as(u64, 0), try service.acknowledgedVisiblePrefix(old));
+    try t.expectEqualDeep(first, service.pollVisibility().?);
+    try t.expectEqual(@as(u64, service.profile.decode_chunk_frames), try service.acknowledgedVisiblePrefix(old));
+    try service.close(old);
+    current = null;
+    try t.expectError(error.StaleStream, service.acknowledgedVisiblePrefix(old));
+
+    current = try fixture.open(31, 4096);
+    const fresh = current.?;
+    try t.expectEqual(old.index, fresh.index);
+    try t.expect(fresh.generation != old.generation);
+    try t.expectError(error.StaleStream, service.acknowledgedVisiblePrefix(old));
+    try t.expectEqual(@as(u64, 0), try service.acknowledgedVisiblePrefix(fresh));
+    try t.expect(service.pollVisibility() == null);
+    try t.expectEqual(@as(u64, 0), try service.acknowledgedVisiblePrefix(fresh));
+    _ = try fixture.accept(fresh, 2);
+    service.beginRenderGate(2, 0);
+    const second = (try service.admitPublication(service.publicationFrontier(), 2, 0, 0)).?;
+    service.endRenderSpan(0);
+    try t.expectEqual(@as(u64, 0), try service.acknowledgedVisiblePrefix(fresh));
+    var receipt: stream.observation.Visibility = .{};
+    try t.expectEqualDeep(second, service.pollVisibilityObserved(&receipt).?);
+    try t.expect(receipt.acknowledged);
+    try t.expectEqual(fresh.generation, receipt.descriptor.?.stream_generation);
+    try t.expectEqual(@as(u64, 4096), receipt.descriptor.?.target_cursor);
+    try t.expectEqual(@as(u64, 0), receipt.descriptor.?.prefix_start);
+    try t.expectEqual(@as(u64, service.profile.decode_chunk_frames), try service.acknowledgedVisiblePrefix(fresh));
+    try t.expectError(error.StaleStream, service.acknowledgedVisiblePrefix(old));
+}
+
+const ReceiptCorruption = enum { stale_generation, noncontiguous };
+
+fn malformedReceipt(kind: ReceiptCorruption) !void {
+    var fixture: Fixture = .{};
+    try fixture.initInPlace();
+    defer fixture.deinit();
+    const service = fixture.service;
+    const handle = try fixture.open(31, 0);
+    defer service.close(handle) catch unreachable;
+    _ = try fixture.accept(handle, 1);
+    service.beginRenderGate(1, 0);
+    const admission = (try service.admitPublication(service.publicationFrontier(), 1, 0, 0)).?;
+    service.endRenderSpan(0);
+    try t.expectEqual(.admitted, admission.disposition);
+    try t.expectEqual(@as(u64, 0), try service.acknowledgedVisiblePrefix(handle));
+
+    // Isolated invariant negative, not evidence of a reachable native receipt.
+    // Corrupt a detached copy only. The real ledger, its leases, actual receipt,
+    // PCM, and all prefix counters are untouched by this test setup.
+    const tail = service.publication_tail.load(.monotonic);
+    const actual = &service.publications[@intCast(tail % service.publications.len)];
+    var malformed = actual.*;
+    switch (kind) {
+        .stale_generation => malformed.descriptor.stream_generation += 1,
+        .noncontiguous => malformed.descriptor.prefix_start += 1,
+    }
+    const identity_valid = streaming.Service.VisibilityReceiptTests.acknowledge(service, &malformed);
+    try t.expectEqual(kind == .noncontiguous, identity_valid);
+    try t.expectEqual(@as(u64, 0), service.slots[handle.index].acknowledged_visible_prefix);
+    try t.expectError(error.InvalidState, service.acknowledgedVisiblePrefix(handle));
+    try t.expectEqual(handle.generation, actual.descriptor.stream_generation);
+    try t.expectEqual(@as(u64, 0), actual.descriptor.prefix_start);
+    try t.expectEqualDeep(admission, actual.admission);
+
+    // Drain the intact real receipt through the normal acquire/acknowledgement
+    // path. Valid later traffic must not clear the previously latched failure.
+    var receipt: stream.observation.Visibility = .{};
+    try t.expectEqualDeep(admission, service.pollVisibilityObserved(&receipt).?);
+    try t.expect(receipt.acknowledged);
+    try t.expectError(error.InvalidState, service.acknowledgedVisiblePrefix(handle));
+    try t.expect(service.pollVisibility() == null);
+    try t.expectError(error.InvalidState, service.acknowledgedVisiblePrefix(handle));
+}
+
+test "isolated copied stale-generation receipt cannot credit a slot and permanently invalidates proof" {
+    try malformedReceipt(.stale_generation);
+}
+
+test "isolated copied noncontiguous receipt cannot grant credit and permanently invalidates proof" {
+    try malformedReceipt(.noncontiguous);
+}
