+test "chronology cold entry makes progress with actual admitted high water despite supply frame movement" {
+    const bytes = try bank();
+    defer a.free(bytes);
+    var oracle = try f.Oracle.decode(bytes);
+    defer oracle.deinit();
+    const rig = try Rig.create(bytes);
