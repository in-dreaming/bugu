+        actual_fault = pendingFault(owner.control);
+        if (actual_fault) |fault| std.debug.print("ACCEPTANCE_RETRY_FAULT frame={d} cursor={d} layer={d}\n", .{ fault.frame, fault.cursor, fault.layer });
